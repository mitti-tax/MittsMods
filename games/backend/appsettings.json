{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Browser origins allowed to call the API. Scheme + host + port only —
  // a path here would never match. Override in production with
  // Cors__AllowedOrigins__0, Cors__AllowedOrigins__1, ...
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4173",
      "https://mitti-tax.github.io"
    ]
  },

  "AdminAuth": {
    "TokenLifetimeHours": 12
  }

  // The connection string and the secrets live outside source control:
  //   ConnectionStrings:DefaultConnection  (or DATABASE_URL)
  //   Twitch:ClientId / Twitch:ClientSecret
  //   Steam:ApiKey / Steam:SteamId
  //   ADMIN_PASSWORD, and optionally TOKEN_SIGNING_KEY
  // Put them in appsettings.Development.json locally, env vars in production.
}
