# Copy to .env on the server, fill in, then: chmod 600 .env
# DB_PASSWORD: use hex only, e.g. openssl rand -hex 24 (it goes in a ;-separated connection string)
DB_PASSWORD=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
STEAM_API_KEY=
STEAM_ID=
ADMIN_PASSWORD=
# From Cloudflare Zero Trust > Networks > Tunnels (added after the domain is active)
TUNNEL_TOKEN=
